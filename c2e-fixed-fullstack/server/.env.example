# ============================================================================
# Connect2EdTech server — environment configuration (EXAMPLE)
# Copy this file to ".env" and adjust the values for your environment.
# All variables are read by server/config/env.js.
# ============================================================================

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------
# Local MongoDB is the DEFAULT. The server connects here unless MONGO_URI is
# overridden. No code changes are needed to switch databases — just change
# this one variable.
MONGO_URI=mongodb://localhost:27017/connect2edtech

# OPTION: MongoDB Atlas
# To run the backend against a MongoDB Atlas cluster instead of a local
# MongoDB, replace the MONGO_URI above with your Atlas connection string.
# Get it from the Atlas UI:  Cluster -> Connect -> Connect your application.
# It looks like:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connect2edtech?retryWrites=true&w=majority
# Example (uncomment and fill in your credentials to use Atlas):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/connect2edtech?retryWrites=true&w=majority
#
# NOTE: The same MONGO_URI is used by `npm run seed:admin` and by the running
# server, so both will automatically target whichever database you configure.

# ----------------------------------------------------------------------------
# Auth / tokens
# ----------------------------------------------------------------------------
# Use a long, random string in production (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (used by the admin dashboard / website).
# For production, set to your deployed frontend URL(s) (comma-separated):
CLIENT_URL=https://connect2edtech.connect2future.com,https://connect2-edtech2-five.vercel.app

# ----------------------------------------------------------------------------
# Email notifications (Gmail SMTP)
# ----------------------------------------------------------------------------
# When someone submits the Contact or Enrollment form on the website, the
# server emails the details to NOTIFY_EMAIL using the Gmail account below.
# If SMTP_HOST/SMTP_USER/SMTP_PASS are left blank, emails are simply skipped
# (a warning is logged) — form submissions still save to the database either
# way, so this is safe to leave unconfigured during local development.
#
# Gmail App Password:
#   1. Enable 2-Factor Authentication on your Google account.
#   2. Generate an "App Password" (not your normal password).
#   3. Use the 16-character app password (with spaces removed) here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASS=

# "From" address shown on the notification email. Defaults to SMTP_USER.
EMAIL_FROM=

# The inbox that should RECEIVE contact/enrollment submissions. Defaults to
# SMTP_USER if left blank.
NOTIFY_EMAIL=
